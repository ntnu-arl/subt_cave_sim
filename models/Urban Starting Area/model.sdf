<?xml version="1.0"?>
<sdf version="1.6">
  <model name="urban_starting_area">
    <static>true</static>
    <link name="base">
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>meshes/starting_area.dae</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>meshes/starting_area.dae</uri>
          </mesh>
        </geometry>
      </visual>

    </link>
        <!--Uncomment <link> to preview detector region>-->
          <!--<link name='body'>
            <pose>5 27 12.5 0 0 0</pose>
            <visual name="v1">
              <transparency>0.5</transparency>
              <geometry>
                <box>
                  <size>24 24 10</size>
              </box>
            </geometry>
            </visual>
            <material>
              <ambient>0.0 1.0 0.0 1</ambient>
              <diffuse>0.0 1.0 0.0 1</diffuse>
              <specular>0.5 0.5 0.5 1</specular>
            </material>
            <cast_shadows>false</cast_shadows>
          </link>-->
          <plugin filename="libignition-gazebo-performer-detector-system.so" name="ignition::gazebo::systems::PerformerDetector">
            <topic>/subt_performer_detector</topic>
            <pose>-13.75 0 15 0 0 0</pose>
            <geometry>
              <box>
                <size>51.5 60 30</size>
              </box>
            </geometry>
          </plugin>

    <!--Uncomment <link> to preview detector region-->
      <!--<link name='body5'>
        <visual name="v1">
          <pose>-25 24 5 0 0 0</pose>
          <transparency>0.2</transparency>
          <geometry>
            <box>
              <size>10 37 10</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.0 1.0 0.0 1</diffuse>
          </material>
        </visual>
        <cast_shadows>false</cast_shadows>
      </link>-->
      <plugin filename="libignition-gazebo-performer-detector-system.so" name="ignition::gazebo::systems::PerformerDetector">
        <topic>/subt_performer_detector</topic>
        <pose>-25 24 5 0 0 0</pose>
        <geometry>
          <box>
            <size>10 37 10</size>
          </box>
        </geometry>
        <header_data>
          <key>type</key>
          <value>elevation</value>
        </header_data>
      </plugin>

    <!--Uncomment <link> to preview detector region-->
      <!--<link name='body6'>
        <visual name="v1">
          <pose>-6 45 8 0 0 0</pose>
          <transparency>0.2</transparency>
          <geometry>
            <box>
              <size>20 10 9</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.0 1.0 0.0 1</diffuse>
